# Copia este archivo a ".env" para desarrollo local. Estos son valores de
# ejemplo para local: NO usar estas contraseñas en un despliegue real.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev_password
POSTGRES_DB=crm
POSTGRES_PORT=5432

# Debe coincidir con la contraseña de app_role creada en
# backend/prisma/migrations/00000000000000_init/migration.sql
APP_ROLE_PASSWORD=app_role_dev_password_change_me

JWT_SECRET=dev_secret_change_me

# Secreto DISTINTO de JWT_SECRET a propósito: aísla los tokens de
# administrador de plataforma de los de usuarios de negocio.
PLATFORM_ADMIN_JWT_SECRET=dev_platform_admin_secret_change_me

# Credenciales de tu cuenta de administrador de la plataforma (la única
# que puede dar de alta negocios nuevos). Se siembra sola al arrancar el
# backend; cambia estos valores antes de cualquier uso real.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change_me_before_real_use

BACKEND_PORT=3000
FRONTEND_PORT=5173
