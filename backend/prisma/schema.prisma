// Prisma se usa aquí solo como generador de cliente tipado + gestor de
// migraciones aplicadas (prisma migrate deploy). Las políticas de Row-Level
// Security viven en SQL puro (ver migrations/00000000000000_init/migration.sql)
// porque Prisma no las modela de forma nativa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Fuera del modelo multi-tenant a propósito: no tiene tenant_id ni RLS
// (ver migrations/20260907001000_add_platform_admins/migration.sql).
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("platform_admins")
}

enum UserRole {
  owner
  admin
  employee

  @@map("user_role")
}

enum InteractionType {
  call
  visit

  @@map("interaction_type")
}

enum CallOutcome {
  sale_closed
  interested
  not_interested
  call_back

  @@map("call_outcome")
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  businessType String?  @map("business_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  users        User[]
  customers    Customer[]
  products     Product[]
  pointsConfig PointsConfig?
  auditLogs    AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(employee)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model PointsConfig {
  tenantId              String   @id @map("tenant_id") @db.Uuid
  pointsPerCurrencyUnit Decimal  @default(1) @map("points_per_currency_unit") @db.Decimal(10, 4)
  minPurchaseAmount     Decimal  @default(0) @map("min_purchase_amount") @db.Decimal(10, 2)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("points_config")
}

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  fullName         String    @map("full_name")
  phone            String?
  email            String?
  pointsBalance    Decimal   @default(0) @map("points_balance") @db.Decimal(12, 2)
  customFields     Json      @default("{}") @map("custom_fields")
  consentMarketing Boolean   @default(false) @map("consent_marketing")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions Interaction[]
  purchases    Purchase[]
  returns      Return[]

  @@map("customers")
}

model Interaction {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  customerId String           @map("customer_id") @db.Uuid
  type       InteractionType
  notes      String?
  outcome    CallOutcome?
  followUpAt DateTime?        @map("follow_up_at") @db.Timestamptz
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  createdBy  String?          @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("interactions")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  category  String?
  price     Decimal  @default(0) @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PurchaseItem[]

  @@map("products")
}

model Purchase {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  pointsEarned Decimal  @default(0) @map("points_earned") @db.Decimal(12, 2)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  returns  Return[]
  items    PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Decimal  @db.Decimal(12, 2)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model Return {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  purchaseId     String   @map("purchase_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  pointsReversed Decimal  @default(0) @map("points_reversed") @db.Decimal(12, 2)
  reason         String?
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("returns")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

model SavedSegment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  periodDays Int      @default(90) @map("period_days")
  matchType  String   @default("all") @map("match_type")
  conditions Json
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("saved_segments")
}

enum LeadStage {
  new
  contacted
  qualified
  proposal
  won
  lost

  @@map("lead_stage")
}

model Lead {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  fullName            String    @map("full_name")
  company             String?
  email               String?
  phone               String?
  linkedinUrl         String?   @map("linkedin_url")
  estimatedValue      Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  stage               LeadStage @default(new)
  notes               String?
  source              String?
  convertedCustomerId String?   @map("converted_customer_id") @db.Uuid
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("leads")
}

enum ContactCategory {
  partner
  interesting

  @@map("contact_category")
}

model Contact {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  category    ContactCategory
  fullName    String          @map("full_name")
  company     String?
  email       String?
  phone       String?
  linkedinUrl String?         @map("linkedin_url")
  notes       String?
  source      String?
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@map("contacts")
}
